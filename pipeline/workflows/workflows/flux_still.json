{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "flux1-dev-fp8.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "boreal-v2.safetensors", "strength_model": 0.8 },
    "_meta": { "title": "Boreal amateur-photo LoRA" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "placeholder" },
    "_meta": { "title": "Positive" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "" },
    "_meta": { "title": "Negative" }
  },
  "5": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["3", 0], "guidance": 3.5 },
    "_meta": { "title": "FluxGuidance" }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 576, "batch_size": 1 },
    "_meta": { "title": "Latent" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0, "steps": 20, "cfg": 1.0, "sampler_name": "euler",
      "scheduler": "simple", "denoise": 1.0,
      "model": ["2", 0], "positive": ["5", 0], "negative": ["4", 0], "latent_image": ["6", 0]
    },
    "_meta": { "title": "KSampler" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["8", 0], "filename_prefix": "flux" },
    "_meta": { "title": "Save" }
  }
}
