# Copy to .env for local runs (docker/uvicorn read the environment).

# --- required: the director LLM ---
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-sonnet-5

# --- talking-head generator: Duix.Avatar (optional) ---
# Deploy github.com/duixcom/Duix-Avatar locally, then point these at it to
# enable POST /api/avatar-jobs (script -> avatar -> edited video, no camera).
DUIX_GEN_VIDEO_URL=           # e.g. http://localhost:8383  (face2face service)
DUIX_TTS_URL=http://localhost:18180   # fish-speech voice-clone service
DUIX_DATA_DIR=/heygem_data    # shared volume the Duix docker services mount

# --- transcription (local, free) ---
WHISPER_MODEL=base            # tiny|base|small|medium|large-v3

# --- asset fallback ladder (all optional; each missing key skips that tier) ---
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
PEXELS_API_KEY=               # free web stock stills
IMAGE_GEN_API_KEY=            # cheap image gen (nano-banana / gemini image)
IMAGE_GEN_MODEL=gemini-2.5-flash-image
AI_VIDEO_GEN_API_KEY=         # last-resort ai video (kling/hailuo/luma)

# --- rendering / cost guardrails ---
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
MAX_AI_VIDEO_SECONDS=10       # cap paid video gen per render
